`timescale 10ns/1ns

module seq_choose(
	input choose,
	input seq1,
	input seq2,
	output reg seq_out
); 
    // 分频（通过计数器实现 50MHz→1kHz）
    reg [15:0] cnt;  // 计数器
	 cnt = 0;
    always @(posedge clk) 
		 begin
				if (cnt >= 24999) 
					  begin  // 50MHz/2/25000 = 1kHz
							  cnt <= 1'b0;
							  clkout <= ~clkout;  // 翻转输出，生成 1kHz 方波
					  end 
				 else 
					  begin
							  cnt <= cnt + 1'b1;
					  end
		 end
endmodule